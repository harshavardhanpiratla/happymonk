{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/our-story", "destination": "/our-story.html" },
    { "source": "/shop", "destination": "/shop.html" },
    { "source": "/shop-the-range", "destination": "/shop.html" },
    { "source": "/signin", "destination": "/signin.html" },
    { "source": "/login", "destination": "/signin.html" },
    { "source": "/signup", "destination": "/signup.html" },
    { "source": "/register", "destination": "/signup.html" },
    { "source": "/account", "destination": "/account.html" },
    { "source": "/cart", "destination": "/cart.html" },
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/order-success", "destination": "/order-success.html" },
    { "source": "/track-order", "destination": "/track-order.html" },
    { "source": "/admin/login", "destination": "/admin-login.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/product", "destination": "/product.html" },
    { "source": "/products/:slug", "destination": "/products/:slug.html" },
    { "source": "/pure-coffee", "destination": "/products/pure-coffee.html" },
    { "source": "/honey", "destination": "/products/honey.html" },
    { "source": "/chilli-powder", "destination": "/products/chilli-powder.html" },
    { "source": "/cooking-ghee", "destination": "/products/cooking-ghee.html" },
    { "source": "/puja-ghee", "destination": "/products/puja-ghee.html" }
  ]
}
