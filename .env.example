# Happy Monk E-Commerce Platform — Environment Configuration Example
# Copy this file to .env and customize for production deployment.

# Server Port (for local node server.js)
PORT=3000

# SQLite Database File Path (defaults to ./data/happy-monk.sqlite locally, /tmp/happy-monk.sqlite on Vercel)
SQLITE_DB_PATH=./data/happy-monk.sqlite

# Initial Administrator Credentials (used to provision the separate /admin/login account)
ADMIN_EMAIL=admin@happymonk.ca
ADMIN_PASSWORD=ChangeThisSecureAdminPassword!2026
ADMIN_NAME=Happy Monk Administrator

# Optional Stripe Integration (leave blank to use Cash on Delivery & Interac e-Transfer)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
